{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "trackdgroundgame",
  "post": {
    "entrypoints": {
      "default": {
        "entry": "splash.html"
      },
      "goals": {
        "entry": "goals.html"
      }
    }
  },
  "server": {},
  "menu": {
    "items": [
      {
        "label": "Create fundraiser tracker post",
        "description": "Post the live Digital Ground Game fundraiser tracker.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/on/menu/new-post"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on/app/install"
  },
  "scripts": {
    "dev": "npm run watch"
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": ["secure.actblue.com"]
    }
  },
  "dev": {
    "subreddit": "trackdgroundgame_dev"
  }
}
