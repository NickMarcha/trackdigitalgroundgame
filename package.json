{
  "private": true,
  "name": "trackdgroundgame",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "clean": "node -e \"for(const p of ['dist','public/splash.js','public/splash.js.map','public/goals.js','public/goals.js.map'])fs.rmSync(p,{recursive:true,force:true})\"",
    "format": "npm run lint -- --fix",
    "lint": "biome check --error-on-warnings",
    "playtest": "devvit playtest",
    "test": "npm run test:types && npm run lint && npm run test:unit && npm run build",
    "test:types": "tsc --build",
    "test:unit": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test src/**/*.test.ts",
    "publish": "npm run clean && npm run build && devvit publish",
    "watch": "node build.mjs --watch",
    "dev": "devvit playtest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@devvit/web": "0.14.3",
    "@types/node": "24.13.4",
    "devvit": "0.14.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
